# No backend block on purpose — this module is never applied (see README.md).
# State would need a real decision (S3+DynamoDB lock table) before this
# stopped being reference-only.

terraform {
  required_version = ">= 1.7"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

provider "aws" {
  region = var.aws_region
}
